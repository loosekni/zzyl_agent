APP_NAME="ZZYL Agent"
API_PREFIX=/api
DATABASE_URL=sqlite:///./zzyl_agent.db

# mock | anthropic | openai | deepseek
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-4-8
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# OpenAI-compatible provider examples:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...
#
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
#
# Anthropic example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-4-8
# LLM_API_KEY=sk-ant-...
